{
  "realm": "archcore-dev",
  "enabled": true,
  "displayName": "archcore Development",
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "smtpServer": {
    "host": "smtp.gmail.com",
    "port": "587",
    "from": "noreply@yourdomain.com",
    "auth": {
      "username": "your-email@gmail.com",
      "password": "your-app-password"
    },
    "starttls": "true",
    "ssl": "false"
  },
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "realm-admin",
        "description": "Realm administrator role"
      },
      {
        "name": "user",
        "description": "Default user role"
      }
    ]
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "archcore-frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"]
    },
    {
      "clientId": "archcore-client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "",
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:8080"],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "config": {
        "clientId": "your-google-client-id.apps.googleusercontent.com",
        "clientSecret": "your-google-client-secret",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "identityProviderAlias": "google",
      "name": "email",
      "identityProviderMapper": "hardcoded-user-attribute-idp-mapper",
      "config": {
        "attribute.name": "email",
        "user.attribute": "email",
        "syncMode": "INHERIT"
      }
    },
    {
      "identityProviderAlias": "google",
      "name": "first-name",
      "identityProviderMapper": "hardcoded-user-attribute-idp-mapper",
      "config": {
        "attribute.name": "firstName",
        "user.attribute": "firstName",
        "syncMode": "INHERIT"
      }
    },
    {
      "identityProviderAlias": "google",
      "name": "last-name",
      "identityProviderMapper": "hardcoded-user-attribute-idp-mapper",
      "config": {
        "attribute.name": "lastName",
        "user.attribute": "lastName",
        "syncMode": "INHERIT"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "change-me-in-production",
          "temporary": true
        }
      ],
      "realmRoles": ["realm-admin", "user"]
    }
  ]
}
