<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-billing-profile-audit-schema" author="Yasin HERKEN">
        <comment>Create billing, profile, and audit tables</comment>

        <createTable tableName="plans">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tier" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="rate_limit_per_minute" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="max_projects" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="max_members" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="subscriptions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="plan_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="TIMESTAMP"/>
            <column name="billing_cycle_start" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="billing_cycle_end" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="external_subscription_id" type="VARCHAR(255)"/>
            <column name="auto_renew" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="subscriptions"
                baseColumnNames="plan_id"
                constraintName="fk_subscriptions_plan"
                referencedTableName="plans"
                referencedColumnNames="id"/>

        <createTable tableName="user_profiles">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="first_name" type="VARCHAR(100)"/>
            <column name="last_name" type="VARCHAR(100)"/>
            <column name="profile_picture_url" type="VARCHAR(500)"/>
            <column name="account_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="deactivation_reason" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="audit_logs">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="endpoint" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="http_method" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="client_ip_address" type="VARCHAR(45)">
                <constraints nullable="false"/>
            </column>
            <column name="http_status_code" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="execution_time_ms" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_agent" type="VARCHAR(500)"/>
            <column name="additional_data" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="subscriptions" indexName="idx_subscriptions_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="subscriptions" indexName="idx_subscriptions_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="user_profiles" indexName="idx_user_profiles_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="audit_logs" indexName="idx_audit_logs_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="audit_logs" indexName="idx_audit_logs_created_at">
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="audit_logs" indexName="idx_audit_logs_endpoint">
            <column name="endpoint"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
