{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
        "idea": {
            "type": "remote",
            "url": "http://127.0.0.1:64342/sse",
            "headers": {}
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp"
        },
        "codebase-memory-mcp": {
            "enabled": true,
            "type": "local",
            "command": [
                "/Users/yasinherken/.local/bin/codebase-memory-mcp"
            ]
        },
        "imos-tag-monitor": {
            "type": "remote",
            "url": "http://localhost:8078/mcp",
        "enabled": true
        }
  },
  "provider": {
    "zen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "mimo-v2.5-free": {
          "name": "MiMo V2.5 Free"
        }
      }
    }
  },
  "model": "zen/mimo-v2.5-free"
}
